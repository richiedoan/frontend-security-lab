  "devDependencies": { "@eslint/js": "^9.35.0", "@nestjs/cli": "^11.0.10", "@nestjs/testing": "^11.1.6", "@types/express": "^5.0.3", "@types/express-session": "^1.18.2", "@types/jest": "^30.0.0", "@types/node": "^22.18.1", "@types/supertest": "^6.0.3", "eslint": "^9.35.0", "globals": "^16.3.0", "jest": "^30.1.3", "supertest": "^7.1.4", "ts-jest": "^29.4.1", "typescript": "^5.9.2", "typescript-eslint": "^8.42.0" },
